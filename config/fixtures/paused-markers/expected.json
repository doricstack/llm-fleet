{
  "config": {
    "stateDir": "<FIXTURE>/runner/.local/state/llm-fleet",
    "speech": {
      "tempDirectory": "<TEMP>"
    },
    "mods": {
      "typing": {
        "stateDir": "<FIXTURE>/runner/.local/state/llm-fleet/typing"
      }
    },
    "sources": {
      "jobs": {
        "state": "unconfigured",
        "providers": []
      },
      "interactive": {
        "state": "unconfigured",
        "providers": []
      },
      "agents": {
        "state": "unconfigured",
        "providers": []
      },
      "progress": {
        "enabled": true,
        "directory": "<FIXTURE>/runs",
        "paused_when_exists": "<FIXTURE>/runner/paused",
        "state": "paused"
      },
      "trials": {
        "enabled": true,
        "database": "<FIXTURE>/changes.db",
        "paused_when_exists": "<FIXTURE>/runner/paused",
        "state": "paused"
      },
      "rates": {
        "state": "ready"
      }
    }
  }
}
